{
  "schema": "pubg_ai_aim.example",
  "schema_version": 1,
  "enabled": false,
  "compatibility": "corrected",
  "runtime": {
    "model": "modules/pubg_ai_aim/runtime/PUBGV8.onnx",
    "onnxruntime": "modules/pubg_ai_aim/runtime/onnxruntime.dll",
    "prefer_directml": true,
    "allow_cpu_fallback": true,
    "dml_device_index": 0,
    "capture_adapter_index": 0,
    "capture_output_index": 0,
    "capture_desktop_rect": {
      "left": 0,
      "top": 0,
      "width": 1920,
      "height": 1080
    },
    "target_fps": 125
  },
  "detector": {
    "input_width": 320,
    "input_height": 320,
    "anchors": 2100,
    "classes": 2,
    "confidence": 0.404,
