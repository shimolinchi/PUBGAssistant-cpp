    "ads_sensitivity_scale_max": 3.0,
    "auto_scope_sensitivity": true,
    "scope_sensitivity": [50.0, 40.0, 42.0, 41.0, 44.0, 50.0]
  },
  "activation": {
    "enabled": false,
    "auto_fire": false,
    "require_game_foreground": true,
    "block_on_inventory_map_menu": true
  },
  "notes": "This is a schema/example artifact only; the core library deliberately has no JSON dependency."
}
